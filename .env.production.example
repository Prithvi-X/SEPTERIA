# ==============================================================================
# SEPTERIA (SIH26186) - Master Production Environment Configuration Example
# ==============================================================================

# Application Environment
APP_ENV=production
PROJECT_NAME="SEPTERIA (SIH26186)"
API_V1_STR=/api/v1

# Server Host & Dynamic Port (Assigned automatically by Railway via $PORT)
BACKEND_HOST=0.0.0.0
# PORT is dynamically injected by Railway / Render

# Production PostgreSQL Database Connection
# Injected automatically by Railway PostgreSQL plugin via DATABASE_URL
# Format: postgresql+psycopg2://postgres:<password>@<host>:<port>/railway
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_STRONG_PASSWORD@roundhouse.proxy.rlwy.net:12345/railway

# Security & JWT Authentication
# Generate a secure 256-bit key: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_256BIT_RANDOM_HEX_SECRET_FOR_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# CORS Allowed Origins (Comma-separated public domains)
CORS_ORIGINS=https://your-authority-web.vercel.app,https://your-personnel-app.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:8080

# Frontend Reference URLs
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app/api/v1
NEXT_PUBLIC_ENABLE_DEV_AUTH_QUICKFILL=true
